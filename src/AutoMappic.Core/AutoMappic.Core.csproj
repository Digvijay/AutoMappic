<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the floor rather than net9.0. There is no framework-conditional
         code in this library, so a net9.0 target produces the same IL as net8.0
         while reaching fewer consumers, and both reach end of support on the same
         day (2026-11-10). net9.0 consumers resolve the net8.0 asset. net10.0 is
         LTS through 2028-11-14. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- These are deliberately NOT suppressed. This project sets IsTrimmable and
         IsAotCompatible, and the repository runs a gate that promotes these codes
         to errors, so silencing them here would have made both claims unverifiable
         while still advertising them to consumers. Any genuine requirement is
         expressed with DynamicallyAccessedMembers, a documented
         UnconditionalSuppressMessage, or a feature switch in
         ILLink.Substitutions.xml that removes the code instead of hiding it. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Removes the reflective fallback from trimmed and Native AOT applications.
         Must be embedded with this exact LogicalName for the trimmer to find it. -->
    <EmbeddedResource Include="ILLink.Substitutions.xml">
      <LogicalName>ILLink.Substitutions.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>AutoMappic.Core</AssemblyName>
    <PackageId>AutoMappic</PackageId>
    <RootNamespace>AutoMappic</RootNamespace>
    <Description>AutoMappic is a zero-reflection, Native AOT-friendly object mapper for .NET 8+ powered by Roslyn Interceptors.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoMappic.Generator\AutoMappic.Generator.csproj" 
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" 
                      PrivateAssets="all" />
    <ProjectReference Include="..\AutoMappic.Generator.CodeFixes\AutoMappic.Generator.CodeFixes.csproj" 
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" 
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- High-quality packaging: Include generator and codefixes DLLs + build targets -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\..\AutoMappic.Generator\bin\$(Configuration)\netstandard2.0\AutoMappic.Generator.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs" 
          Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\..\AutoMappic.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\AutoMappic.Generator.CodeFixes.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs" 
          Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\..\AutoMappic.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\System.Composition.*.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="AutoMappic.targets" 
          Pack="true" 
          PackagePath="build" />
  </ItemGroup>

  <PropertyGroup>
    <PackageTags>mapper;mapping;source-generator;interceptors;aot;performance;dotnet-9</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
