<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A tool, not a library: this is the runtime users must have installed to
         run it, so it tracks LTS rather than the library's compatibility floor.
         net9.0 reaches end of support on 2026-11-10; net10.0 runs to 2028-11-14. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>automappic</ToolCommandName>
    <PackageId>AutoMappic.Cli</PackageId>
    <Description>CLI tool for AutoMappic: mapping validation and visualization.</Description>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>mapper;mapping;cli;dotnet-tool;aot;performance</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- IDE0005 (remove unnecessary usings) only runs at build time when the compiler is
         also producing a documentation file; without this it is silently not enforced
         here even though .editorconfig sets it to warning. The tool is not a reference
         library, so the generated XML is not packed - it exists to turn the rule on. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="AutoMappic.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- Transitive security pin; see the note in Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <!-- MSBuildLocator loads MSBuild from the SDK instance it registers at
         run time. Microsoft.CodeAnalysis.Workspaces.MSBuild drags Microsoft.Build
         in transitively, and without ExcludeAssets="runtime" those assemblies are
         also copied next to the tool, where they shadow the registered ones and
         break assembly loading. Build.Locator 1.11.2 detects this as MSBL001. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoMappic.Generator\AutoMappic.Generator.csproj" />
  </ItemGroup>
</Project>
